    <!-- ================= Operation status colors (old look: Green / Firebrick / LightSteelBlue track) ================= -->
    <SolidColorBrush x:Key="CoabSuccessBrush" Color="Green" />
    <SolidColorBrush x:Key="CoabErrorBrush" Color="Firebrick" />
    <SolidColorBrush x:Key="CoabProgressTrackBrush" Color="LightSteelBlue" />

    <!-- ================= Default icon path style ================= -->
    <Style x:Key="CoabIcon" TargetType="Path">
        <Setter Property="Fill" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemMenuTextBrushKey}}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================= Flat VS-themed button (main actions, ported flat look) ================= -->
    <Style x:Key="CoabButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ButtonTextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemButtonFaceBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.DropDownBorderBrushKey}}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static platformUi:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static platformUi:EnvironmentColors.CommandBarBorderBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static platformUi:EnvironmentColors.CommandBarMouseDownBackgroundBeginBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Borderless icon button (toolbar / hover actions) ================= -->
    <Style x:Key="CoabIconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemMenuTextBrushKey}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static platformUi:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static platformUi:EnvironmentColors.CommandBarBorderBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Tiny priority spinner button ================= -->
    <Style x:Key="CoabSpinnerButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static platformUi:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Link-look button (ported DropDownTextLink optic: link color, underline on hover) ================= -->
    <Style x:Key="CoabLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ControlLinkTextBrushKey}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <Border x:Name="line"
                                VerticalAlignment="Bottom"
                                Visibility="Hidden"
                                Height="1"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ControlLinkTextBrushKey}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="line" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ControlLinkTextHoverBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Themed checkbox for the steps row ================= -->
    <Style x:Key="CoabCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemMenuTextBrushKey}}" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ================= Flat progress bar (ported COABProgressBar) ================= -->
    <Style x:Key="COABProgressBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{StaticResource CoabProgressTrackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CoabSuccessBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Determinate" />
                                <VisualState x:Name="Indeterminate">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.3" To="1" Duration="0:0:0.8"
                                                         AutoReverse="True" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="PART_Track"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" />
                        <Border x:Name="PART_Indicator"
                                BorderThickness="0"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Subtle expander (ported ExpanderTemplate: thin lines, rotating triangle) ================= -->
    <Style x:Key="CoabExpanderToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemMenuTextBrushKey}}" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd"
                            CornerRadius="2"
                            Background="{TemplateBinding Background}"
                            Margin="{TemplateBinding Margin}"
                            SnapsToDevicePixels="True">
                        <Viewbox x:Name="viewBox"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Margin="4,0,3,0"
                                 Height="8"
                                 RenderTransformOrigin="0.5, 0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Viewbox.RenderTransform>
                            <Path Fill="{TemplateBinding Foreground}"
                                  Stretch="Fill"
                                  Data="M0,0L496.000005990267,315 0,630z" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="viewBox" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="45" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ControlLinkTextHoverBrushKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="CoabExpanderTemplate" TargetType="{x:Type Expander}">
        <DockPanel>
            <Border x:Name="Bd"
                    DockPanel.Dock="Top"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0,1,0,1"
                    Margin="0,-1,0,0"
                    SnapsToDevicePixels="True"
                    Height="25">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="Expander"
                                  Style="{StaticResource CoabExpanderToggleButtonStyle}"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press" />
                    <ContentPresenter x:Name="PART_Header"
                                      ContentSource="Header"
                                      TextElement.FontWeight="Medium"
                                      Grid.Column="1"
                                      TextElement.Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemMenuTextBrushKey}}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </Grid>
            </Border>
            <ContentPresenter x:Name="ItemsHost" Margin="0,2,0,7" />
        </DockPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_Header" Property="Opacity" Value="0.5" />
                <Setter TargetName="Expander" Property="Opacity" Value="0.5" />
            </Trigger>
            <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ================= Vertical separator for action rows ================= -->
    <Style x:Key="CoabVerticalSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Width="1"
                            Margin="6,2"
                            Background="{DynamicResource {x:Static platformUi:EnvironmentColors.CommandBarToolBarSeparatorBrushKey}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
