<UserControl x:Class="CheckoutAndBuild.VisualStudio.ToolWindows.MainToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinWidth" Value="28" />
        </Style>
        <Style x:Key="PriorityButton" TargetType="Button">
            <Setter Property="FontSize" Value="7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="11" />
        </Style>
        <Style x:Key="ServiceCheck" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="6">
        <!-- toolbar -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button Content="▶ Run" Command="{Binding RunCommand}" Style="{StaticResource ToolButton}"
                    ToolTip="Run the pipeline on all included solutions" />
            <Button Content="⏸ Pause" Command="{Binding PauseCommand}" Style="{StaticResource ToolButton}" />
            <Button Content="⏵ Resume" Command="{Binding ResumeCommand}" Style="{StaticResource ToolButton}" />
            <Button Content="⏹ Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ToolButton}" />
            <Border Width="1" Margin="4,2" Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" Opacity="0.3" />
            <Button Content="+ Folder" Command="{Binding AddFolderCommand}" Style="{StaticResource ToolButton}"
                    ToolTip="Add a working folder" />
            <Button Content="⟳ Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource ToolButton}"
                    ToolTip="Rescan all working folders" />
        </WrapPanel>
        <!-- service selection -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Steps:" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
            <CheckBox Content="Clean" IsChecked="{Binding IsCleanEnabled}" Style="{StaticResource ServiceCheck}" />
            <CheckBox Content="Checkout" IsChecked="{Binding IsCheckoutEnabled}" Style="{StaticResource ServiceCheck}" />
            <CheckBox Content="Restore" IsChecked="{Binding IsRestoreEnabled}" Style="{StaticResource ServiceCheck}" />
            <CheckBox Content="Build" IsChecked="{Binding IsBuildEnabled}" Style="{StaticResource ServiceCheck}" />
            <CheckBox Content="Test" IsChecked="{Binding IsTestEnabled}" Style="{StaticResource ServiceCheck}" />
        </WrapPanel>
        <!-- overall progress -->
        <Grid DockPanel.Dock="Top" Height="16" Margin="0,0,0,6">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="10" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />
        </Grid>
        <!-- last error -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding LastError}" Foreground="Firebrick"
                   TextWrapping="Wrap" ToolTip="{Binding LastError}" />
        <!-- solutions grouped by working folder -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding WorkingFolders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="True" Margin="0,0,0,6"
                                  Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" Margin="8,0,0,0"
                                            ToolTip="Remove this working folder"
                                            Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Path}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Solutions}" Margin="18,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Build only" Command="{Binding BuildOnlyCommand}" />
                                                    <MenuItem Header="Clean only" Command="{Binding CleanOnlyCommand}" />
                                                    <MenuItem Header="Test only" Command="{Binding TestOnlyCommand}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" VerticalAlignment="Center"
                                                      ToolTip="Include this solution in pipeline runs" />
                                            <Ellipse Grid.Column="1" Width="10" Height="10" Margin="6,0"
                                                     Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding SolutionFileName}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ItemPath}" />
                                            <ProgressBar Grid.Column="3" Width="70" Height="10" Margin="6,0"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding Progress, Mode=OneWay}"
                                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                                         VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BuildPriority}" MinWidth="16" TextAlignment="Center"
                                                           VerticalAlignment="Center" ToolTip="Build priority (lower builds first)" />
                                                <StackPanel>
                                                    <Button Content="▲" Command="{Binding IncreasePriorityCommand}"
                                                            Style="{StaticResource PriorityButton}" ToolTip="Build earlier" />
                                                    <Button Content="▼" Command="{Binding DecreasePriorityCommand}"
                                                            Style="{StaticResource PriorityButton}" ToolTip="Build later" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="5" Text="{Binding StatusText}" Width="110" Margin="6,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="6" Text="{Binding ResultText}" MaxWidth="260" Margin="6,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Opacity="0.75" ToolTip="{Binding ResultText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
