<UserControl x:Class="CheckoutAndBuild.VisualStudio.ToolWindows.MainToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:settings="clr-namespace:CheckoutAndBuild.VisualStudio.Settings"
             theming:ImageThemingUtilities.ImageBackgroundColor="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBackgroundColorKey}}"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CheckoutAndBuild.VisualStudio;component/Themes/CoabStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

    <DockPanel Margin="8">
        <DockPanel.Style>
            <Style TargetType="DockPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActiveSettings}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Style>

        <Border DockPanel.Dock="Top" Height="20" Margin="0,0,0,8"
                CornerRadius="3" ClipToBounds="True"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.DropDownBorderBrushKey}}">
            <Grid>
                <ProgressBar Style="{StaticResource COABProgressBar}"
                             Background="Transparent"
                             Foreground="{Binding StateBrush}"
                             Opacity="0.35"
                             Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}" />

                <Rectangle x:Name="shimmer" Width="140" HorizontalAlignment="Left" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#30FFFFFF" Offset="0.5" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="shimmerTransform" X="-140" />
                    </Rectangle.RenderTransform>
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RunState}" Value="Running">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="shimmerStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="-140" To="900" Duration="0:0:2.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="shimmerStoryboard" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="{Binding StatusGlyph}"
                               FontSize="11"
                               Margin="0,1,5,0"
                               VerticalAlignment="Center"
                               Foreground="{Binding StateBrush}" />
                    <TextBlock Text="{Binding StatusLineText}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemMenuTextBrushKey}}" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource CoabIconButton}"
                        Command="{Binding AddFolderCommand}"
                        ToolTip="Add a working folder">
                    <Path Style="{StaticResource CoabIcon}" Data="{StaticResource CoabPlusGeometry}" />
                </Button>
                <Button Style="{StaticResource CoabIconButton}" Margin="4,0,0,0"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Rescan all working folders">
                    <Path Style="{StaticResource CoabIcon}" Data="{StaticResource CoabRefreshGeometry}" Width="12" Height="12" />
                </Button>
                <Button Style="{StaticResource CoabIconButton}" Margin="4,0,0,0"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="CheckoutAndBuild settings">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="12" />
                </Button>
                <Button Style="{StaticResource CoabIconButton}" Margin="4,0,0,0"
                        Click="OnMoreClick"
                        ToolTip="More actions">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="12" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export as .bat…" Command="{Binding ExportBatchCommand}"
                                      ToolTip="Export the enabled pipeline steps as a batch script" />
                            <MenuItem Header="Export as .ps1…" Command="{Binding ExportPowershellCommand}"
                                      ToolTip="Export the enabled pipeline steps as a PowerShell script" />
                            <Separator />
                            <MenuItem Header="Suggest Build Priorities" Command="{Binding SuggestPrioritiesCommand}"
                                      ToolTip="Scan cross-solution references and set the build order automatically (referenced solutions build first)" />
                            <Separator />
                            <MenuItem Header="Sort by">
                                <MenuItem Header="Build Priority" IsChecked="{Binding IsSortByPriority, Mode=OneWay}"
                                          Command="{Binding SetSortModeCommand}" CommandParameter="BuildPriority" />
                                <MenuItem Header="Name" IsChecked="{Binding IsSortByName, Mode=OneWay}"
                                          Command="{Binding SetSortModeCommand}" CommandParameter="Name" />
                                <MenuItem Header="Services" IsChecked="{Binding IsSortByServices, Mode=OneWay}"
                                          Command="{Binding SetSortModeCommand}" CommandParameter="Services" />
                                <MenuItem Header="Project Type" IsChecked="{Binding IsSortByProjectType, Mode=OneWay}"
                                          Command="{Binding SetSortModeCommand}" CommandParameter="ProjectType" />
                                <Separator />
                                <MenuItem Header="Descending" IsChecked="{Binding SortDescending, Mode=OneWay}"
                                          Command="{Binding ToggleSortDescendingCommand}" />
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding CurrentProfile}"
                          MinWidth="90" FontSize="11"
                          VerticalAlignment="Center"
                          ToolTip="Working profile">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <Button Style="{StaticResource CoabIconButton}" Margin="2,0,0,0"
                        Click="OnMoreClick"
                        ToolTip="Manage working profiles">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="12" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="New profile…" Command="{Binding AddProfileCommand}"
                                      ToolTip="Create a new working profile" />
                            <MenuItem Header="Rename profile…" Command="{Binding RenameProfileCommand}"
                                      ToolTip="Rename the current profile (keeps its settings)" />
                            <MenuItem Header="Delete profile…" Command="{Binding DeleteProfileCommand}"
                                      ToolTip="Remove the current profile ('Default' cannot be deleted)" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Steps:" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"
                           ToolTip="Pipeline steps executed for every included solution" />
                <CheckBox Content="Clean" IsChecked="{Binding IsCleanEnabled}" Style="{StaticResource CoabCheckBox}"
                          ToolTip="Delete build output before checkout" />
                <CheckBox Content="Checkout" IsChecked="{Binding IsCheckoutEnabled}" Style="{StaticResource CoabCheckBox}"
                          ToolTip="Pull latest sources from git" />
                <CheckBox Content="Restore" IsChecked="{Binding IsRestoreEnabled}" Style="{StaticResource CoabCheckBox}"
                          ToolTip="Restore NuGet packages" />
                <CheckBox Content="Build" IsChecked="{Binding IsBuildEnabled}" Style="{StaticResource CoabCheckBox}"
                          ToolTip="Build the solutions" />
                <CheckBox Content="Test" IsChecked="{Binding IsTestEnabled}" Style="{StaticResource CoabCheckBox}"
                          ToolTip="Run the test suites" />
            </WrapPanel>
        </DockPanel>

        <Grid DockPanel.Dock="Top" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="3" MinHeight="24" Margin="4,0,0,0" Padding="8,0"
                    Command="{Binding RetryFailedCommand}"
                    ToolTip="Run the pipeline again for the failed solutions only">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CoabButton}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RunState}" Value="Failed">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{StaticResource CoabErrorBrush}" />
                    <TextBlock Text="Retry failed" VerticalAlignment="Center" FontSize="11" />
                </StackPanel>
            </Button>

            <Button Grid.Column="0" MinHeight="26"
                    Style="{StaticResource CoabButton}"
                    Command="{Binding RunCommand}"
                    ToolTip="Run the pipeline on all included solutions">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CoabPlayGeometry}"
                          Fill="{DynamicResource {x:Static platformUi:EnvironmentColors.ButtonTextBrushKey}}"
                          Stretch="Uniform" Width="10" Height="10"
                          VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="CheckoutAndBuild" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Width="36" MinHeight="24" Margin="4,0,0,0"
                    Command="{Binding PauseCommand}"
                    ToolTip="Pause the pipeline run">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CoabButton}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Path Data="{StaticResource CoabPauseGeometry}"
                      Fill="{DynamicResource {x:Static platformUi:EnvironmentColors.ButtonTextBrushKey}}"
                      Stretch="Uniform" Width="10" Height="10" />
            </Button>

            <Button Grid.Column="1" Width="36" MinHeight="24" Margin="4,0,0,0"
                    Command="{Binding ResumeCommand}"
                    ToolTip="Resume the pipeline run">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CoabButton}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Path Data="{StaticResource CoabPlayGeometry}"
                      Fill="{DynamicResource {x:Static platformUi:EnvironmentColors.ButtonTextBrushKey}}"
                      Stretch="Uniform" Width="10" Height="10" />
            </Button>

            <Button Grid.Column="2" Width="36" MinHeight="24" Margin="4,0,0,0"
                    Style="{StaticResource CoabButton}"
                    Command="{Binding CancelCommand}"
                    ToolTip="Cancel the pipeline run">
                <Path Data="{StaticResource CoabStopGeometry}"
                      Fill="{DynamicResource {x:Static platformUi:EnvironmentColors.ButtonTextBrushKey}}"
                      Stretch="Uniform" Width="9" Height="9" />
            </Button>
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBox x:Name="filterBox" FontSize="11" Padding="18,1,2,1"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter solutions by name (Ctrl+E focuses this box, Esc clears)" />
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="11"
                       Margin="5,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                       IsHitTestVisible="False" Opacity="0.5"
                       Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemMenuTextBrushKey}}" />
            <TextBlock Text="Filter solutions (Ctrl+E)" FontSize="11"
                       Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                       IsHitTestVisible="False" Opacity="0.45"
                       Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemMenuTextBrushKey}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=filterBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0"
                   Text="{Binding LastError}"
                   Foreground="{StaticResource CoabErrorBrush}"
                   TextWrapping="Wrap"
                   ToolTip="{Binding LastError}" />

        <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemMenuTextBrushKey}}"
                   FontStyle="Italic" FontSize="11"
                   TextWrapping="Wrap"
                   ToolTip="{Binding StatusMessage}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <StackPanel Margin="0,44,0,0" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WorkingFolders.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xED25;" FontSize="34"
                           HorizontalAlignment="Center" Opacity="0.35"
                           Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemMenuTextBrushKey}}" />
                <TextBlock Text="No working folders yet" FontWeight="SemiBold" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,10,0,2" />
                <TextBlock Text="Add a folder — solutions and git repositories are discovered automatically."
                           FontSize="11" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="280" />
                <Button Style="{StaticResource CoabButton}" MinHeight="26" Margin="0,14,0,0" Padding="14,0"
                        HorizontalAlignment="Center"
                        Command="{Binding AddFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource CoabIcon}" Data="{StaticResource CoabPlusGeometry}"
                              Fill="{DynamicResource {x:Static platformUi:EnvironmentColors.ButtonTextBrushKey}}"
                              Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Add Working Folder…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding WorkingFolders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,6" CornerRadius="4" Padding="6,4"
                              Background="{DynamicResource {x:Static platformUi:EnvironmentColors.DropDownBackgroundBrushKey}}"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.DropDownBorderBrushKey}}">
                        <Expander IsExpanded="True"
                                  Template="{StaticResource CoabExpanderTemplate}"
                                  HorizontalContentAlignment="Stretch"
                                  Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemMenuTextBrushKey}}">
                            <Expander.Header>
                                <DockPanel x:Name="folderHeader" LastChildFill="True" Background="Transparent"
                                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                    <DockPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add Solution…"
                                                      Command="{Binding PlacementTarget.Tag.AddSolutionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"
                                                      ToolTip="Add solutions outside the folder scan" />
                                            <MenuItem Header="Merge to One Solution"
                                                      Command="{Binding PlacementTarget.Tag.MergeFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"
                                                      ToolTip="Merge all included solutions of this folder into one !Merged_Build_*.sln" />
                                            <MenuItem Header="Open in File Explorer"
                                                      Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <Button DockPanel.Dock="Right" Margin="8,0,4,0"
                                            Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove this working folder">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CoabIconButton}">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=folderHeader}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Path Style="{StaticResource CoabIcon}" Data="{StaticResource CoabCancelGeometry}" Width="9" Height="9" />
                                    </Button>

                                    <Button DockPanel.Dock="Right" FontSize="11" Margin="8,0,0,0"
                                            Click="OnRepositoriesLinkClick"
                                            ToolTip="Branches and worktrees of all repositories in this folder"
                                            Visibility="{Binding ShowRepositoriesSummary, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource CoabLinkButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource CoabBranchGeometry}"
                                                  Fill="{DynamicResource {x:Static platformUi:EnvironmentColors.ControlLinkTextBrushKey}}"
                                                  Stretch="Uniform" Width="9" Height="11"
                                                  Margin="0,0,3,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RepositoriesSummary}" VerticalAlignment="Center" />
                                            <Path Data="M 0 0 L 8 12 L 16 0 Z"
                                                  Fill="{DynamicResource {x:Static platformUi:EnvironmentColors.ControlLinkTextBrushKey}}"
                                                  Stretch="Uniform" Width="7" Height="5"
                                                  Margin="3,2,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Repositories}"
                                                  VerticalAlignment="Center" Margin="8,0,0,0"
                                                  Visibility="{Binding ShowRepositoriesInline, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentBranch}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button FontSize="11" Margin="4,0,0,0"
                                                            Click="OnBranchLinkClick"
                                                            ToolTip="{Binding RepositoryPath}"
                                                            Style="{StaticResource CoabLinkButton}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource CoabBranchGeometry}"
                                                                  Fill="{DynamicResource {x:Static platformUi:EnvironmentColors.ControlLinkTextBrushKey}}"
                                                                  Stretch="Uniform" Width="9" Height="11"
                                                                  Margin="0,0,3,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding SyncBadge}" VerticalAlignment="Center"
                                                                       Margin="4,0,0,0" FontSize="10" Opacity="0.8"
                                                                       ToolTip="Commits ahead/behind the upstream branch (since the last fetch)" />
                                                            <Path Data="M 0 0 L 8 12 L 16 0 Z"
                                                                  Fill="{DynamicResource {x:Static platformUi:EnvironmentColors.ControlLinkTextBrushKey}}"
                                                                  Stretch="Uniform" Width="7" Height="5"
                                                                  Margin="3,2,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button FontSize="11" Margin="3,0,0,0"
                                                            Command="{Binding SyncCommand}"
                                                            ToolTip="Sync: fetch, pull when behind, push when ahead (sets the upstream when missing)"
                                                            Style="{StaticResource CoabLinkButton}">
                                                        <TextBlock VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="⇅" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                                                            <Setter Property="Text" Value="…" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding Path}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}" />
                                </DockPanel>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding IncludedSolutions}" Margin="16,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Build only" Command="{Binding BuildOnlyCommand}" />
                                                    <MenuItem Header="Clean only" Command="{Binding CleanOnlyCommand}" />
                                                    <MenuItem Header="Test only" Command="{Binding TestOnlyCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="Start" Command="{Binding StartCommand}"
                                                              ToolTip="Run the built executable of this solution" />
                                                    <MenuItem Header="Start and Attach Debugger" Command="{Binding StartDebuggerCommand}"
                                                              ToolTip="Run the built executable and attach the VS debugger" />
                                                    <MenuItem Header="Restart" Command="{Binding RestartCommand}"
                                                              ToolTip="Stop running instances, then start again" />
                                                    <MenuItem Header="Stop" Command="{Binding StopCommand}"
                                                              ToolTip="Kill processes running from this solution's output directories" />
                                                    <Separator />
                                                    <MenuItem Header="Open Solution" Command="{Binding OpenSolutionCommand}"
                                                              ToolTip="Open this solution in the current Visual Studio instance" />
                                                    <MenuItem Header="Open with" ItemsSource="{Binding OpenWithOptions}"
                                                              ToolTip="Open this solution in another Visual Studio">
                                                        <MenuItem.ItemContainerStyle>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Header" Value="{Binding Header}" />
                                                                <Setter Property="Command" Value="{Binding Command}" />
                                                            </Style>
                                                        </MenuItem.ItemContainerStyle>
                                                    </MenuItem>
                                                    <MenuItem Header="Open in File Explorer" Command="{Binding OpenInExplorerCommand}" />
                                                    <MenuItem Header="Open Output Directory" Command="{Binding OpenOutputDirectoryCommand}"
                                                              ToolTip="Open the first existing project output directory" />
                                                    <MenuItem Header="Show History" Command="{Binding ShowHistoryCommand}"
                                                              ToolTip="Show the git history of this solution's repository" />
                                                    <MenuItem Header="Open in CheckoutAndBuild Git" Command="{Binding OpenInGitWindowCommand}"
                                                              ToolTip="Open this solution's repository in the CheckoutAndBuild Git window" />
                                                    <MenuItem Header="Copy Full Path" Command="{Binding CopyFullPathCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="Show Errors…" Command="{Binding ShowErrorsCommand}"
                                                              ToolTip="Errors of the last failed run, with retry" />
                                                    <MenuItem Header="Settings…" Command="{Binding SettingsCommand}"
                                                              ToolTip="Solution-specific settings (override the global settings)" />
                                                    <MenuItem Header="Remove from list" Command="{Binding RemoveFromListCommand}"
                                                              ToolTip="Remove this manually added solution again">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" MinHeight="20">
                                                <CheckBox DockPanel.Dock="Left"
                                                          IsChecked="{Binding IsIncluded}"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Include this solution in pipeline runs" />
                                                <Ellipse DockPanel.Dock="Left"
                                                         Width="10" Height="10" Margin="6,0"
                                                         Fill="{Binding StatusBrush}"
                                                         VerticalAlignment="Center"
                                                         ToolTip="{Binding StatusText}" />
                                                <imaging:CrispImage DockPanel.Dock="Left"
                                                                    Moniker="{Binding IconMoniker}"
                                                                    Width="16" Height="16"
                                                                    Margin="0,0,2,0"
                                                                    VerticalAlignment="Center" />

                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="8,0,0,0"
                                                            ToolTip="Build priority (lower builds first)">
                                                    <TextBox Text="{Binding BuildPriority, UpdateSourceTrigger=LostFocus}"
                                                             MinWidth="24" TextAlignment="Right" FontSize="11"
                                                             VerticalAlignment="Center"
                                                             KeyDown="OnPriorityBoxKeyDown"
                                                             ToolTip="Build priority — type a value or use the arrows (Enter applies)"
                                                             Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ControlLinkTextBrushKey}}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource {x:Static platformUi:CommonControlsColors.TextBoxBackgroundBrushKey}}" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <StackPanel Margin="2,0,0,0" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CoabSpinnerButton}"
                                                                Command="{Binding IncreasePriorityCommand}"
                                                                ToolTip="Build earlier">
                                                            <Path Style="{StaticResource CoabIcon}" Data="{StaticResource CoabUpGeometry}" Width="7" Height="4" />
                                                        </Button>
                                                        <Button Style="{StaticResource CoabSpinnerButton}"
                                                                Command="{Binding DecreasePriorityCommand}"
                                                                ToolTip="Build later">
                                                            <Path Style="{StaticResource CoabIcon}" Data="{StaticResource CoabDownGeometry}" Width="7" Height="4" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Button x:Name="servicesLink"
                                                            Style="{StaticResource CoabLinkButton}"
                                                            FontSize="11"
                                                            Click="OnServicesLinkClick"
                                                            Tag="{Binding ElementName=servicesPopup}">
                                                        <Button.ToolTip>
                                                            <StackPanel>
                                                                <TextBlock Text="The included services for this solution" />
                                                                <TextBlock Text="{Binding ServicesCaption}" />
                                                                <TextBlock Text="{Binding BuildPropertiesCaption}" />
                                                                <TextBlock Text="{Binding BuildTargetsCaption}" />
                                                            </StackPanel>
                                                        </Button.ToolTip>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ServicesCaptionSmall}" />
                                                            <Path Data="M 0 0 L 8 12 L 16 0 Z"
                                                                  Fill="{DynamicResource {x:Static platformUi:EnvironmentColors.ControlLinkTextBrushKey}}"
                                                                  Stretch="Uniform" Width="7" Height="5"
                                                                  Margin="3,2,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Popup x:Name="servicesPopup"
                                                           PlacementTarget="{Binding ElementName=servicesLink}"
                                                           Placement="Bottom"
                                                           MinWidth="170"
                                                           PopupAnimation="Slide"
                                                           AllowsTransparency="True"
                                                           StaysOpen="False">
                                                        <Border Background="{DynamicResource {x:Static platformUi:EnvironmentColors.CommandBarMenuBackgroundGradientBrushKey}}"
                                                                BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.DropDownBorderBrushKey}}"
                                                                BorderThickness="1">
                                                            <StackPanel Margin="8,6">
                                                                <CheckBox Content="Clean" IsChecked="{Binding IsCleanEnabled}"
                                                                          Style="{StaticResource CoabCheckBox}" Margin="0,3" />
                                                                <CheckBox Content="Checkout" IsChecked="{Binding IsCheckoutEnabled}"
                                                                          Style="{StaticResource CoabCheckBox}" Margin="0,3" />
                                                                <CheckBox Content="Restore" IsChecked="{Binding IsRestoreEnabled}"
                                                                          Style="{StaticResource CoabCheckBox}" Margin="0,3" />
                                                                <CheckBox Content="Build" IsChecked="{Binding IsBuildEnabled}"
                                                                          Style="{StaticResource CoabCheckBox}" Margin="0,3" />
                                                                <CheckBox Content="Test" IsChecked="{Binding IsTestEnabled}"
                                                                          Style="{StaticResource CoabCheckBox}" Margin="0,3" />
                                                                <Separator Margin="0,4" />
                                                                <Button Style="{StaticResource CoabLinkButton}" HorizontalAlignment="Left" Margin="0,2"
                                                                        Content="{Binding BuildPropertiesCaption}"
                                                                        Command="{Binding EditBuildPropertiesCommand}"
                                                                        ToolTip="Additional msbuild /p: properties for this solution" />
                                                                <Button Style="{StaticResource CoabLinkButton}" HorizontalAlignment="Left" Margin="0,2"
                                                                        Content="{Binding BuildTargetsCaption}"
                                                                        Command="{Binding EditBuildTargetsCommand}"
                                                                        ToolTip="msbuild targets for this solution (default: Build)" />
                                                                <Button Style="{StaticResource CoabLinkButton}" HorizontalAlignment="Left" Margin="0,2"
                                                                        Content="Solution Settings..."
                                                                        Command="{Binding SettingsCommand}"
                                                                        ToolTip="Solution-specific settings (override the global settings)" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </StackPanel>

                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding StatusText}"
                                                           Foreground="{Binding StatusBrush}"
                                                           MaxWidth="130" Margin="6,0,0,0"
                                                           FontSize="10" FontStyle="Italic"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding StatusText}"
                                                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Path Data="{StaticResource CoabSuccessGeometry}"
                                                          Fill="{StaticResource CoabSuccessBrush}"
                                                          Stretch="Uniform" Width="10" Height="10"
                                                          VerticalAlignment="Center"
                                                          ToolTip="{Binding ResultText}"
                                                          Visibility="{Binding HasSucceeded, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource CoabIconButton}"
                                                            Command="{Binding ShowErrorsCommand}"
                                                            ToolTip="Show the errors of the last run (with retry)"
                                                            Visibility="{Binding HasFailed, Converter={StaticResource BoolToVis}}">
                                                        <Path Data="{StaticResource CoabErrorGeometry}"
                                                              Fill="{StaticResource CoabErrorBrush}"
                                                              Stretch="Uniform" Width="9" Height="9"
                                                              VerticalAlignment="Center" />
                                                    </Button>
                                                    <TextBlock Text="{Binding ResultText}"
                                                               Margin="4,0,0,0" MaxWidth="240" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding StatusBrush}"
                                                               ToolTip="{Binding ResultText}" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding SolutionFileName}"
                                                           Margin="4,0,8,0"
                                                           VerticalAlignment="Center"
                                                           FontStyle="Italic"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding RowToolTip}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>

                                            <ProgressBar Grid.Row="1" Height="3" Margin="24,1,0,1"
                                                         Style="{StaticResource COABProgressBar}"
                                                         Foreground="{Binding StatusBrush}"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding Progress, Mode=OneWay}"
                                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                      </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander IsExpanded="False"
                      Margin="0,8,0,4"
                      Template="{StaticResource CoabExpanderTemplate}"
                      HorizontalContentAlignment="Stretch"
                      Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemMenuTextBrushKey}}">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExcludedSolutions.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Expander.Header>
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center"
                               ToolTip="Solutions excluded from pipeline runs"><Run Text="Excluded (" /><Run Text="{Binding ExcludedSolutions.Count, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding ExcludedSolutions}" Margin="16,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1" MinHeight="20">
                                <CheckBox DockPanel.Dock="Left"
                                          IsChecked="{Binding IsIncluded}"
                                          VerticalAlignment="Center"
                                          ToolTip="Include this solution in pipeline runs again" />
                                <TextBlock Text="{Binding SolutionFileName}"
                                           Margin="6,0,8,0" Opacity="0.7"
                                           VerticalAlignment="Center"
                                           FontStyle="Italic"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ItemPath}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
          </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <settings:SettingsView DataContext="{Binding ActiveSettings}">
        <settings:SettingsView.Style>
            <Style TargetType="{x:Type settings:SettingsView}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </settings:SettingsView.Style>
    </settings:SettingsView>

    </Grid>
</UserControl>
